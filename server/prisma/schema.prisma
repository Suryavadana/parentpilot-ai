// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Family {
  id        String   @id @default(cuid())
  name      String
  users     User[]
  children  Child[]
  events    Event[]
  doctors   Doctor[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Child {
  id                String          @id @default(cuid())
  fullName          String
  dateOfBirth       DateTime
  gender            String?
  school            String?
  grade             String?
  bloodGroup        String?
  allergies         String?
  medicalConditions String?
  profilePhotoUrl   String?
  familyId          String
  family            Family          @relation(fields: [familyId], references: [id])
  events            Event[]
  homework          Homework[]
  fees              Fee[]
  dailySchedule     DailySchedule[]
  activities        Activity[]
  medications       Medication[]
  doctors           Doctor[]
  appointments      Appointment[]
  vaccinations      Vaccination[]
  growthRecords     GrowthRecord[]
  feedback          Feedback[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  category    String
  startDate   DateTime
  endDate     DateTime?
  location    String?
  allDay      Boolean   @default(false)
  childId     String?
  child       Child?    @relation(fields: [childId], references: [id])
  familyId    String
  family      Family    @relation(fields: [familyId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Homework {
  id        String   @id @default(cuid())
  title     String
  subject   String
  dueDate   DateTime
  status    String   @default("not_started")
  notes     String?
  childId   String
  child     Child    @relation(fields: [childId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Fee {
  id          String   @id @default(cuid())
  description String
  amount      Decimal
  dueDate     DateTime
  status      String   @default("unpaid")
  childId     String
  child       Child    @relation(fields: [childId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DailySchedule {
  id        String   @id @default(cuid())
  dayOfWeek Int
  startTime String
  endTime   String
  subject   String
  location  String?
  notes     String?
  childId   String
  child     Child    @relation(fields: [childId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Activity {
  id           String   @id @default(cuid())
  name         String
  activityType String?
  coachName    String?
  venue        String?
  contactInfo  String?
  dayOfWeek    Int?
  startTime    String?
  endTime      String?
  notes        String?
  childId      String
  child        Child    @relation(fields: [childId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Medication {
  id        String    @id @default(cuid())
  name      String
  dosage    String
  frequency String
  startDate DateTime
  endDate   DateTime?
  notes     String?
  childId   String
  child     Child     @relation(fields: [childId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Doctor {
  id           String        @id @default(cuid())
  name         String
  specialty    String?
  phone        String?
  email        String?
  address      String?
  notes        String?
  childId      String?
  child        Child?        @relation(fields: [childId], references: [id])
  familyId     String
  family       Family        @relation(fields: [familyId], references: [id])
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Appointment {
  id          String   @id @default(cuid())
  reason      String
  scheduledAt DateTime
  status      String   @default("upcoming")
  notes       String?
  childId     String
  child       Child    @relation(fields: [childId], references: [id])
  doctorId    String?
  doctor      Doctor?  @relation(fields: [doctorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Vaccination {
  id               String    @id @default(cuid())
  vaccineName      String
  doseNumber       Int?
  dateAdministered DateTime
  nextDueDate      DateTime?
  administeredBy   String?
  notes            String?
  childId          String
  child            Child     @relation(fields: [childId], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model GrowthRecord {
  id        String   @id @default(cuid())
  date      DateTime
  heightCm  Float?
  weightKg  Float?
  notes     String?
  childId   String
  child     Child    @relation(fields: [childId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Feedback {
  id        String   @id @default(cuid())
  source    String
  category  String
  content   String
  date      DateTime
  childId   String
  child     Child    @relation(fields: [childId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  // Role within the user's family: "owner", "parent", or "caregiver".
  role         String   @default("parent")
  familyId     String
  family       Family   @relation(fields: [familyId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
